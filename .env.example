# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# Production/preview values live in Coolify; GitHub Actions only gets migration/deploy credentials (docs/deployment.md).
# Docker (README → Docker): NEXT_PUBLIC_* are build args, the rest are runtime-only env vars.

# --- Clerk (https://dashboard.clerk.com → API keys; local + preview use the dev instance) ---
# Public key for the Clerk frontend SDK (inlined into the client bundle at build time).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only Clerk API key used by middleware and server code.
CLERK_SECRET_KEY=
# Server-only secret that verifies Clerk webhook signatures (Svix) on the webhook route.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Supabase (local: run `npm run db:status` and copy API_URL / ANON_KEY / SERVICE_ROLE_KEY) ---
# Supabase API URL; local stack default is http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon key (safe in the browser; access is enforced by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role key that bypasses RLS; never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry error tracking (optional; README → Error tracking). Unset = off ---
# Build time: DSN for browser + server (public; inlined into the client bundle).
# NEXT_PUBLIC_SENTRY_DSN=
# Build time: environment name shown in Sentry (production / preview); default NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Runtime: optional server-only DSN override (container env).
# SENTRY_DSN=
# Build time: Sentry org and project slugs for source-map upload (not secret).
# SENTRY_ORG=
# SENTRY_PROJECT=
# Build-time secret: uploads source maps; Docker gets it via --secret, never --build-arg.
# SENTRY_AUTH_TOKEN=
# Build + runtime: release name (commit SHA); Docker/CI set it. Default: package.json version.
# APP_VERSION=
# Runtime: 1 enables the /debug/error test page (throws test errors). Keep off in production.
# ENABLE_TEST_ERROR_PAGE=
# Runtime: 1 serves the developer-only /dev pages (design tokens) in a production build; `next dev` always does.
# ENABLE_DEV_PAGES=

# --- Tests (optional; see tests/README.md) ---
# Clerk dev-instance user the e2e sign-in helper signs in as (must exist there).
# E2E_CLERK_USER_EMAIL=e2e-user+clerk_test@example.com
